// 稟議申請システム（兼務を前提としたワークフローと権限モデル）の Souther モデル。
//
// 自然言語での仕様は ../spec.md を参照。
//
// このリポジトリの他のモデルに対する Souther の特徴は、仕様が *実行可能* である
// こと。下記の `example` の各行はコンパイラが検査し、各 behavior は JSON 入力を
// 与えて CLI から実行できる。
//
// モデル化の方針（他のモデルとの比較はこのディレクトリの README.md を参照）:
//   - 状態は直和型で表し、状態ごとに 1 つのケースを置く。各ケースはその状態に
//     存在するフィールドだけを持つ（承認者は申請が Approved になって初めて
//     現れる）ので、ありえない組み合わせはそもそも書けない。
//   - behavior の入力型が、そのまま状態に対する事前条件になる。`approve` は
//     `Request` ではなく `Pending` を受け取るため、Draft や終端状態の申請を
//     承認しようとすると、実行時の拒否ではなくコンパイルエラーになる（性質 P2）。
//   - (ユーザー, 部署) -> 役職 は `Directory` の値として表し、入力データとして
//     渡す（集合の不変条件は隠れた依存ではなく入力である）。その不変条件が
//     「1 つの所属につき役職は 1 つ」と P3（各部署に上長が 1 名以上）を表す。
//   - 拒否は例外ではなく通常の直和のケース（`NotAffiliated` / `NotAuthor` /
//     `NotManager`）であり、呼び出し側は `match` で受ける。
//   - `decide` は CLI 用の単一の入口。任意の `Request` と任意の `Command` を
//     受け取り、その組を遷移か拒否に写す。状態とコマンドの不整合を実行時に
//     答えるのは `TerminalRequest` と `WrongState` のこの場所だけ。
module approval_request

// === 識別子 ===
data UserId = String
    invariant nonEmpty = String.length(value) > 0

data DepartmentId = String
    invariant nonEmpty = String.length(value) > 0

// === (ユーザー, 部署) -> 役職 ===
// ユーザーは複数の部署に所属でき（兼務）、部署ごとに役職が異なりうる。
// 上長はある部署の *中での* 役職であり、ユーザー単体の属性ではない。
data Role = Member | Manager

data Affiliation =
    { user: UserId
    , department: DepartmentId
    , role: Role
    }

let affiliationKey (a: Affiliation): String = a.user.value ++ "@" ++ a.department.value

let hasManager (department: DepartmentId, entries: List<Affiliation>): Bool =
    List.any(a -> a.department == department && a.role == Manager, entries)

// 組織全体の役職の割り当て。一意性と P3 は集合そのものの性質なので、
// 集合の不変条件として置く。
data Directory = List<Affiliation>
    invariant oneRolePerAffiliation = List.allDistinctBy(affiliationKey, value)
    invariant everyDepartmentHasManager = List.all(a -> hasManager(a.department, value), value)

let affiliationOf (directory: Directory, user: UserId, department: DepartmentId) =
    List.find(a -> a.user == user && a.department == department, directory.value)

let isAffiliated (directory: Directory, user: UserId, department: DepartmentId): Bool =
    match affiliationOf(directory, user, department) with
        | Some a -> true
        | None -> false

let isManagerOf (directory: Directory, user: UserId, department: DepartmentId): Bool =
    match affiliationOf(directory, user, department) with
        | Some a -> a.role == Manager
        | None -> false

// === 申請の内容 ===
data Title = String
    invariant nonEmpty = String.length(value) > 0

data Amount = Int
    invariant nonNegative = value >= 0

data Content =
    { title: Title
    , amount: Amount
    }

// === 稟議申請の状態 ===
// すべての状態が共通に持つフィールド。作成者と申請先部署は申請が存在する限り
// 変わらず、誰が操作したかはその操作が起きた状態にだけ記録される。
data RequestCore =
    { author: UserId
    , department: DepartmentId
    , content: Content
    }

data Draft =
    { ...RequestCore
    }
data Pending =
    { ...RequestCore
    }
data Returned =
    { ...RequestCore
    , returnedBy: UserId
    }
data Approved =
    { ...RequestCore
    , approvedBy: UserId
    }
data Rejected =
    { ...RequestCore
    , rejectedBy: UserId
    }

data Request = Draft | Pending | Returned | Approved | Rejected

// 入力の別名: そのアクションを開始できる状態の集合。これらを入力型に持つ
// behavior は、他の状態をコンパイル時に拒否する。Approved と Rejected は
// どの別名にも現れない（P2）。
data Editable = Draft | Pending | Returned
data Submittable = Draft | Returned

// === 拒否 ===
data NotAffiliated
data NotAuthor
data NotManager
data TerminalRequest
data WrongState

data Denied = NotAffiliated | NotAuthor | NotManager | TerminalRequest | WrongState

// === ディレクトリの登録 ===
// Directory を得る唯一の方法は、その構築を試みること。不変条件の各項がそれぞれ
// 別のケースに分岐するので、規則をここで再掲しなくても、呼び出し側はどの規則を
// 破ったのかを知ることができる。
behavior registerDirectory : (
    entries: List<Affiliation>
) -> Directory | DuplicateAffiliation | DepartmentWithoutManager
    constructs Directory

let registerDirectory (entries) = {
    guard Directory(entries) as directory else
        | oneRolePerAffiliation -> DuplicateAffiliation
        | everyDepartmentHasManager -> DepartmentWithoutManager
    directory
}

// === 申請の作成（§4 A）===
// 申請先部署に所属するユーザーは、その部署宛ての Draft を作成できる。
// Amount と Title は構築を試みるので、不正な内容は異常終了ではなくケースになる。
behavior create : (
    directory: Directory,
    author: UserId,
    department: DepartmentId,
    title: String,
    amount: Int
) -> Draft | NotAffiliated | InvalidContent
    constructs Draft, Content, Title, Amount
    ensures Draft -> value.author == author && value.department == department

let create (directory, author, department, title, amount) = {
    guard isAffiliated(directory, author, department) else NotAffiliated
    guard Title(title) as t else InvalidContent
    guard Amount(amount) as a else InvalidContent
    Draft { author = author, department = department, content = Content { title = t, amount = a } }
}

// === 閲覧（§3 R1, R2）===
// 閲覧は遷移ではなく述語であり、申請がそのまま返るか、閲覧者が拒否されるかの
// どちらかになる。何も構築しない。
behavior read : (directory: Directory, reader: UserId, request: Request) -> Request | NotAffiliated

let read (directory, reader, request) = {
    guard isAffiliated(directory, reader, request.department) else NotAffiliated
    request
}

// === 申請の編集（§3 U1, U2, U3）===
// 作成者は Draft と Returned の申請を編集できる。申請先部署の上長はさらに
// Pending の申請も編集できる。状態は保たれる: `match` が同じケースを新しい
// 内容で組み直す。
let canEdit (directory: Directory, editor: UserId, request: Editable): Bool =
    match request with
        | Draft -> editor == request.author || isManagerOf(directory, editor, request.department)
        | Returned -> editor == request.author || isManagerOf(directory, editor, request.department)
        | Pending -> isManagerOf(directory, editor, request.department)

behavior edit : (
    directory: Directory,
    editor: UserId,
    request: Editable,
    content: Content
) -> Editable | NotAuthor | NotManager
    constructs Draft, Pending, Returned
    ensures sameAuthor = Draft | Pending | Returned -> value.author == request.author
    ensures newContent = Draft | Pending | Returned -> value.content == content

let edit (directory, editor, request, content) = {
    guard canEdit(directory, editor, request)
        else match request with
            | Pending -> NotManager
            | Draft | Returned -> NotAuthor
    match request with
        | Draft as d -> Draft { ...d, content }
        | Pending as p -> Pending { ...p, content }
        | Returned as r -> Returned { ...r, content }
}

// === 申請の提出 / 再提出（§4 C）===
// 提出できるのは作成者だけで、Draft または Returned から行う。Pending は
// `returnedBy` を宣言していないため、再提出でこのフィールドは落ちる。
behavior submit : (actor: UserId, request: Submittable) -> Pending | NotAuthor
    constructs Pending
    ensures Pending -> value.author == request.author

let submit (actor, request) = {
    guard actor == request.author else NotAuthor
    Pending { ...request }
}

// === 承認 / 却下 / 差し戻し（§4 D, E, F）===
// 決裁できるのは *申請先部署の* 上長だけ。自己決裁は許可される: 規則が問うのは
// 申請先部署での実行者の役職であり、実行者が作成者本人かどうかではない。他部署
// の上長は、別の部署で作成者の上長であっても、ここでは NotManager になる（P1）。
behavior approve : (directory: Directory, actor: UserId, request: Pending) -> Approved | NotManager
    constructs Approved
    ensures Approved -> value.approvedBy == actor && value.author == request.author

let approve (directory, actor, request) = {
    guard isManagerOf(directory, actor, request.department) else NotManager
    Approved { ...request, approvedBy = actor }
}

behavior reject : (directory: Directory, actor: UserId, request: Pending) -> Rejected | NotManager
    constructs Rejected
    ensures Rejected -> value.rejectedBy == actor && value.author == request.author

let reject (directory, actor, request) = {
    guard isManagerOf(directory, actor, request.department) else NotManager
    Rejected { ...request, rejectedBy = actor }
}

behavior return : (directory: Directory, actor: UserId, request: Pending) -> Returned | NotManager
    constructs Returned
    ensures Returned -> value.returnedBy == actor && value.author == request.author

let return (directory, actor, request) = {
    guard isManagerOf(directory, actor, request.department) else NotManager
    Returned { ...request, returnedBy = actor }
}

// === decide: 動的な入口 ===
// 上の型付き behavior は、ありえない遷移を書けないようにする。しかし外の世界は
// 任意の申請に対して任意のコマンドを送ってくるので、`decide` がその組を絞り込ん
// で各 behavior に委譲する。(状態, コマンド) のすべての組に答えており、欠けが
// あればコンパイラが弾く。その申請を閲覧すらできない実行者に状態を漏らさない
// よう、NotAffiliated を最初に判定する。
data EditCommand =
    { content: Content
    }

data Command = EditCommand | SubmitCommand | ApproveCommand | RejectCommand | ReturnCommand

behavior decide : (
    directory: Directory,
    actor: UserId,
    request: Request,
    command: Command
) -> Request | Denied

let decide (directory, actor, request, command) = {
    guard isAffiliated(directory, actor, request.department) else NotAffiliated
    match request with
        | Approved | Rejected -> TerminalRequest
        | Draft as d
            -> match command with
                | EditCommand { content } -> edit(directory, actor, d, content)
                | SubmitCommand -> submit(actor, d)
                | ApproveCommand | RejectCommand | ReturnCommand -> WrongState
        | Returned as r
            -> match command with
                | EditCommand { content } -> edit(directory, actor, r, content)
                | SubmitCommand -> submit(actor, r)
                | ApproveCommand | RejectCommand | ReturnCommand -> WrongState
        | Pending as p
            -> match command with
                | EditCommand { content } -> edit(directory, actor, p, content)
                | SubmitCommand -> WrongState
                | ApproveCommand -> approve(directory, actor, p)
                | RejectCommand -> reject(directory, actor, p)
                | ReturnCommand -> return(directory, actor, p)
}
