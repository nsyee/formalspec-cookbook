function step(dir: Directory, actor: UserId, r: Request, cmd: Command): Outcome
{
  if !(canRead(dir, actor, r)) then
    failure(Denial.NotAffiliated)
  else
    if isTerminal(r.status) then
      failure(Denial.TerminalRequest)
    else
      match cmd {
        case Edit(i_cmd_content) =>
          if canEdit(dir, actor, r) then
            success(edit(dir, actor, r, i_cmd_content))
          else
            failure((if r.status.Pending? then Denial.NotManager else Denial.NotAuthor))
        case Submit =>
          if canSubmit(actor, r) then
            success(submit(actor, r))
          else
            failure((if r.status.Pending? then Denial.WrongState else Denial.NotAuthor))
        case Approve =>
          if canDecide(dir, actor, r) then
            success(approve(dir, actor, r))
          else
            failure((if r.status.Pending? then Denial.NotManager else Denial.WrongState))
        case Reject =>
          if canDecide(dir, actor, r) then
            success(reject(dir, actor, r))
          else
            failure((if r.status.Pending? then Denial.NotManager else Denial.WrongState))
        case Return =>
          if canDecide(dir, actor, r) then
            success(returnToAuthor(dir, actor, r))
          else
            failure((if r.status.Pending? then Denial.NotManager else Denial.WrongState))
      }
}

lemma step_ensures(dir: Directory, actor: UserId, r: Request, cmd: Command)
  ensures (step(dir, actor, r, cmd).Success? ==> canRead(dir, actor, r))
  ensures (isTerminal(r.status) ==> step(dir, actor, r, cmd).Failure?)
  ensures (step(dir, actor, r, cmd).Success? ==> ((step(dir, actor, r, cmd).value.author == r.author) && (step(dir, actor, r, cmd).value.department == r.department)))
  ensures (step(dir, actor, r, cmd).Success? ==> ((cmd.Approve? || cmd.Reject?) || cmd.Return?) ==> canDecide(dir, actor, r))
  ensures (step(dir, actor, r, cmd).Success? ==> cmd.Submit? ==> (canSubmit(actor, r) && step(dir, actor, r, cmd).value.status.Pending?))
  ensures (step(dir, actor, r, cmd).Success? ==> cmd.Edit? ==> (canEdit(dir, actor, r) && (step(dir, actor, r, cmd).value.status == r.status)))
  ensures (canDecide(dir, actor, r) ==> cmd.Approve? ==> (step(dir, actor, r, cmd).Success? && step(dir, actor, r, cmd).value.status.Approved?))
  ensures (canDecide(dir, actor, r) ==> cmd.Reject? ==> (step(dir, actor, r, cmd).Success? && step(dir, actor, r, cmd).value.status.Rejected?))
  ensures (canDecide(dir, actor, r) ==> cmd.Return? ==> (step(dir, actor, r, cmd).Success? && step(dir, actor, r, cmd).value.status.Returned?))
  ensures (step(dir, actor, r, cmd).Success? ==> (step(dir, actor, r, cmd).value.status != r.status) ==> (!(isTerminal(r.status)) && (if r.status.Pending? then (isTerminal(step(dir, actor, r, cmd).value.status) || step(dir, actor, r, cmd).value.status.Returned?) else step(dir, actor, r, cmd).value.status.Pending?)))
{
}

function hasManager(dir: Directory, dep: DepartmentId): bool
{
}
by method {
  var i_user_keys := SetToSeq(dir.roles.Keys);
  var i_user_idx := 0;
  while i_user_idx < |i_user_keys|
    invariant (i_user_idx <= |i_user_keys|)
  {
    var user := i_user_keys[i_user_idx];
    var affiliations := dir.roles[user];
    if ((dep in affiliations) && (var i_value := affiliations[dep]; i_value.Manager?)) {
      return true;
    }
    i_user_idx := i_user_idx + 1;
  }
  return false;
}

function departmentsHaveManagers(dir: Directory): bool
{
}
by method {
  var i_user_keys := SetToSeq(dir.roles.Keys);
  var i_user_idx := 0;
  while i_user_idx < |i_user_keys|
    invariant (i_user_idx <= |i_user_keys|)
  {
    var user := i_user_keys[i_user_idx];
    var affiliations := dir.roles[user];
    var i_dep_keys := SetToSeq(affiliations.Keys);
