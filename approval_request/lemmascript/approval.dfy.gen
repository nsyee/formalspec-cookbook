method SetToSeq<T>(s: set<T>) returns (res: seq<T>)
  ensures forall x :: x in s <==> x in res
  ensures |res| == |s|
  ensures forall i, j :: 0 <= i < j < |res| ==> res[i] != res[j]
{
  var remaining := s;
  res := [];
  while remaining != {}
    invariant remaining <= s
    invariant forall x :: x in res <==> (x in s && x !in remaining)
    invariant |res| + |remaining| == |s|
    invariant forall i, j :: 0 <= i < j < |res| ==> res[i] != res[j]
    decreases remaining
  {
    var x :| x in remaining;
    res := res + [x];
    remaining := remaining - {x};
  }
}

type UserId = string

type DepartmentId = string

datatype Role = Member | Manager

datatype Directory = Directory(roles: map<string, map<string, Role>>)

datatype Content = Content(title: string, amount: int)

datatype Status = Draft | Pending | Returned(returnedBy: string) | Approved(approvedBy: string) | Rejected(rejectedBy: string)

datatype Request = Request(author: string, department: string, content: Content, status: Status)

datatype Command = Edit(content: Content) | Submit | Approve | Reject | Return

datatype Denial = NotAffiliated | NotAuthor | NotManager | TerminalRequest | WrongState | InvalidContent | NoSuchRequest

datatype Outcome = Success(value: Request) | Failure(denial: Denial)

datatype Event = Event(actor: string, command: Command)

function isAffiliated(dir: Directory, user: UserId, dep: DepartmentId): bool
{
  ((user in dir.roles) && (var i_affiliations_val := dir.roles[user]; (dep in i_affiliations_val)))
}

function isManagerOf(dir: Directory, user: UserId, dep: DepartmentId): bool
{
  ((user in dir.roles) && (var i_affiliations_val := dir.roles[user]; ((dep in i_affiliations_val) && (var i_value := i_affiliations_val[dep]; i_value.Manager?))))
}

lemma isManagerOf_ensures(dir: Directory, user: UserId, dep: DepartmentId)
  ensures (isManagerOf(dir, user, dep) ==> isAffiliated(dir, user, dep))
{
}

function validContent(c: Content): bool
{
  ((c.title != "") && (c.amount >= 0))
}

function isTerminal(s: Status): bool
{
  (s.Approved? || s.Rejected?)
}

function isEditableByAuthor(s: Status): bool
{
  (s.Draft? || s.Returned?)
}

function wellFormed(dir: Directory, r: Request): bool
{
  isAffiliated(dir, r.author, r.department)
}

function canRead(dir: Directory, actor: UserId, r: Request): bool
{
  isAffiliated(dir, actor, r.department)
}

lemma canRead_ensures(dir: Directory, actor: UserId, r: Request)
  ensures (canRead(dir, actor, r) == isAffiliated(dir, actor, r.department))
{
}

function canEdit(dir: Directory, actor: UserId, r: Request): bool
{
  (((actor == r.author) && isEditableByAuthor(r.status)) || (isManagerOf(dir, actor, r.department) && !(isTerminal(r.status))))
}

lemma canEdit_ensures(dir: Directory, actor: UserId, r: Request)
  ensures (canEdit(dir, actor, r) ==> !(isTerminal(r.status)))
  ensures ((actor == r.author) ==> isEditableByAuthor(r.status) ==> canEdit(dir, actor, r))
  ensures (isManagerOf(dir, actor, r.department) ==> r.status.Pending? ==> canEdit(dir, actor, r))
  ensures ((actor != r.author) ==> !(isManagerOf(dir, actor, r.department)) ==> !(canEdit(dir, actor, r)))
{
}

function canSubmit(actor: UserId, r: Request): bool
{
  ((actor == r.author) && isEditableByAuthor(r.status))
}

lemma canSubmit_ensures(actor: UserId, r: Request)
  ensures (canSubmit(actor, r) == ((actor == r.author) && isEditableByAuthor(r.status)))
{
}

function canDecide(dir: Directory, actor: UserId, r: Request): bool
{
  (r.status.Pending? && isManagerOf(dir, actor, r.department))
}

lemma canDecide_ensures(dir: Directory, actor: UserId, r: Request)
  ensures (canDecide(dir, actor, r) == (r.status.Pending? && isManagerOf(dir, actor, r.department)))
{
}

function success(r: Request): Outcome
{
  Success(r)
}

function failure(d: Denial): Outcome
{
  Failure(d)
}

function create(dir: Directory, author: UserId, dep: DepartmentId, content: Content): Outcome
{
  if !(isAffiliated(dir, author, dep)) then
    failure(Denial.NotAffiliated)
  else
    if !(validContent(content)) then
      failure(Denial.InvalidContent)
    else
      success(Request(author, dep, content, Status.Draft))
}

lemma create_ensures(dir: Directory, author: UserId, dep: DepartmentId, content: Content)
  ensures (create(dir, author, dep, content).Success? ==> ((create(dir, author, dep, content).value.author == author) && (create(dir, author, dep, content).value.department == dep)))
  ensures (create(dir, author, dep, content).Success? ==> (create(dir, author, dep, content).value.status.Draft? && wellFormed(dir, create(dir, author, dep, content).value)))
  ensures (create(dir, author, dep, content).Success? ==> validContent(content))
  ensures (isAffiliated(dir, author, dep) ==> validContent(content) ==> create(dir, author, dep, content).Success?)
{
}

function edit(dir: Directory, actor: UserId, r: Request, content: Content): Request
  requires canEdit(dir, actor, r)
{
  r.(content := content)
}

