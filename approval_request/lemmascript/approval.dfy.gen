      invariant (i_dep_idx <= |i_dep_keys|)
    {
      var dep := i_dep_keys[i_dep_idx];
      var role := affiliations[dep];
      var i_t0 := hasManager(dir, dep);
      if !(i_t0) {
        return false;
      }
      i_dep_idx := i_dep_idx + 1;
    }
    i_user_idx := i_user_idx + 1;
  }
  return true;
}

method run(dir: Directory, r: Request, events: seq<Event>) returns (res: Request)
  ensures (res.author == r.author)
  ensures (res.department == r.department)
  ensures (wellFormed(dir, r) ==> wellFormed(dir, res))
  ensures (isTerminal(r.status) ==> (res == r))
{
  var current := r;
  var i := 0;
  while (i < |events|)
    invariant (0 <= i)
    invariant (i <= |events|)
    invariant (current.author == r.author)
    invariant (current.department == r.department)
    invariant (isTerminal(r.status) ==> (current == r))
  {
    var i_t1 := step(dir, events[i].actor, current, events[i].command);
    var outcome := i_t1;
    match outcome {
      case Success(i_outcome_value) =>
        current := i_outcome_value;
      case Failure(i_outcome_denial) =>

    }
    i := (i + 1);
  }
  return current;
}

class Workflow {
  var directory: Directory
  var requests: map<int, Request>
  var nextId: int

  method open(author: UserId, dep: DepartmentId, content: Content) returns (res: Outcome)
    requires forall id: int :: ((id in this.requests) ==> wellFormed(this.directory, this.requests[id]))
    ensures forall id: int :: ((id in this.requests) ==> wellFormed(this.directory, this.requests[id]))
    ensures (res.Success? ==> (((this.nextId - 1) in this.requests) && (this.requests[(this.nextId - 1)] == res.value)))
    ensures (res.Success? ==> (((res.value.author == author) && (res.value.department == dep)) && res.value.status.Draft?))
  {
    var i_t2 := create(this.directory, author, dep, content);
    var outcome := i_t2;
    match outcome {
      case Success(i_outcome_value) =>
        var stored := this.requests;
        stored := stored[this.nextId := i_outcome_value];
        this.requests := stored;
        this.nextId := (this.nextId + 1);
      case Failure(i_outcome_denial) =>

    }
    return outcome;
  }
  method apply(actor: UserId, id: int, cmd: Command) returns (res: Outcome)
    requires forall k: int :: ((k in this.requests) ==> wellFormed(this.directory, this.requests[k]))
    ensures forall k: int :: ((k in this.requests) ==> wellFormed(this.directory, this.requests[k]))
    ensures (res.Success? ==> ((id in this.requests) && (this.requests[id] == res.value)))
  {
    if (id in this.requests) {
      var i_current_val := this.requests[id];
      var i_t3 := step(this.directory, actor, i_current_val, cmd);
      var outcome := i_t3;
      match outcome {
        case Success(i_outcome_value) =>
          var stored := this.requests;
          stored := stored[id := i_outcome_value];
          this.requests := stored;
        case Failure(i_outcome_denial) =>

      }
      return outcome;
    } else {
      var i_t4 := failure(Denial.NoSuchRequest);
      return i_t4;
    }
  }
}
